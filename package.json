{
  "name": "z80next",
  "private": true,
  "type": "module",
  "description": "z80live serverless : compilation Z80 côté client (WASM), base SQLite portable, API CRUD tout-JS",
  "scripts": {
    "import": "node --experimental-sqlite db/import.mjs",
    "classify": "node --experimental-sqlite db/classify.mjs",
    "build:wasm": "bash fantams/build-wasm.sh",
    "build:app": "npm --prefix app run build",
    "build": "npm run build:wasm && npm run build:app",
    "serve": "node --experimental-sqlite server/api.mjs",
    "dev": "PORT=3000 node --experimental-sqlite server/api.mjs",
    "dev:full": "npm run build && PORT=3000 node --experimental-sqlite server/api.mjs",
    "export:lite": "node --experimental-sqlite scripts/export-lite.mjs",
    "export:sna": "node --experimental-sqlite scripts/export-sna.mjs",
    "export:sna:zip": "node --experimental-sqlite scripts/export-sna.mjs --zip"
  },
  "engines": {
    "node": ">=22.5"
  }
}
